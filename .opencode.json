{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/big-pickle",
  "agent": {
    "build": {
      "model": "opencode/big-pickle"
    },
    "builder": {
      "model": "opencode/big-pickle"
    },
    "explore": {
      "model": "opencode/big-pickle"
    },
    "plan": {
      "description": "Frontier planner. Turns a goal into a file-level spec for the local builder. Read-only except git push.",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "git push*": "ask",
          "*": "allow"
        }
      }
    }
  },
  "mcp": {
    "ydc-server": {
      "enabled": true
    },
    "aws-cli": {
      "enabled": false
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/secrets/**": "deny",
      "**/.git/**": "deny",
      "**/node_modules/**": "deny",
      "**/__pycache__/**": "deny"
    },
    "edit": "allow",
    "write": "allow",
    "bash": {
      "rm*": "ask",
      "git push*": "ask",
      "gh*": "ask",
      "*": "allow"
    }
  }
}