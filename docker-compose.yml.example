# Example docker-compose for running the PREBUILT Sylloge image from GHCR.
# Copy this file to docker-compose.yml to use it.
#
#   cp docker-compose.yml.example docker-compose.yml
#   docker compose up -d
#
# Then create a sylloge.toml config file (see sylloge.toml.example) and it
# will be mounted read-only at /config/sylloge.toml inside the container.

services:
  sylloge:
    # Prebuilt image published to GHCR on each tagged release.
    # "latest" tracks the most recent release; pin a tag for stability
    # (e.g. ghcr.io/parvosub/sylloge:v1.0.0).
    image: ghcr.io/parvosub/sylloge:latest
    container_name: sylloge
    restart: unless-stopped
    ports:
      - "8080:8080"
    environment:
      - SYLLOGE_ADDR=:8080
      - SYLLOGE_DB=/data/sylloge.db
      - SYLLOGE_CONFIG=/config/sylloge.toml
    volumes:
      - sylloge-data:/data
      # Mount your config file read-only. Create it from sylloge.toml.example
      # and point llm.api.base_url at your LLM (Ollama or a cloud provider).
      - ./sylloge.toml:/config/sylloge.toml:ro

volumes:
  sylloge-data:
